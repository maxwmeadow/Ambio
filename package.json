{
  "name": "ambio",
  "version": "0.1.0",
  "description": "Live Architectural Intelligence for the AI Development Era",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/maxwmeadow/Ambio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwmeadow/Ambio.git"
  },
  "bugs": {
    "url": "https://github.com/maxwmeadow/Ambio/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run build:archd && npm run build:adapters && npm run build:agent",
    "dev": "electron-vite dev",
    "build": "npm run build:mcp && npm run build:adapters && npm run build:agent && electron-vite build",
    "coverage:archd": "cd archd-go && go test -cover ./...",
    "coverage:node": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test \"src/**/*.test.mjs\" \"mcp/**/*.test.mjs\" \"electron/**/*.test.mjs\"",
    "test:renderer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mjs\" \"mcp/**/*.test.mjs\" \"electron/**/*.test.mjs\" \"adapters/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:mcp": "npm run build:archd && npm run build:adapters && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"mcp/e2e/*.e2e.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "preview": "electron-vite preview",
    "prepackage": "npm run build:archd && npm run build:mcp && npm run notices && npm run build:agent",
    "package": "electron-vite build && electron-builder",
    "build:archd": "node scripts/archd.mjs build",
    "dbquery": "node scripts/archd.mjs dbquery",
    "test:archd": "node scripts/archd.mjs test",
    "vet:archd": "node scripts/archd.mjs vet",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:adapters": "node scripts/build-adapters.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "test:chat": "npm run build:agent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/agent-chat/*.e2e.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xyflow/react": "^12.0.0",
    "electron-updater": "^6.2.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "shiki": "^4.3.1",
    "simple-icons": "^16.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.0",
    "acorn": "^8.18.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.ambio.app",
    "productName": "Ambio",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maxwmeadow",
        "repo": "Ambio",
        "releaseType": "draft"
      }
    ],
    "protocols": [
      {
        "name": "Ambio",
        "schemes": [
          "ambio"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "archd-go/archd",
          "to": "archd"
        },
        {
          "from": "out/mcp",
          "to": "mcp"
        },
        {
          "from": "out/adapters",
          "to": "adapters"
        },
        {
          "from": "out/licenses",
          "to": "licenses"
        },
        {
          "from": "CHANGELOG.md",
          "to": "CHANGELOG.md"
        },
        {
          "from": "out/agent",
          "to": "agent"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "archd-go/archd.exe",
          "to": "archd.exe"
        },
        {
          "from": "out/mcp",
          "to": "mcp"
        },
        {
          "from": "out/adapters",
          "to": "adapters"
        },
        {
          "from": "out/licenses",
          "to": "licenses"
        },
        {
          "from": "CHANGELOG.md",
          "to": "CHANGELOG.md"
        },
        {
          "from": "out/agent",
          "to": "agent"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "extraResources": [
        {
          "from": "archd-go/archd",
          "to": "archd"
        },
        {
          "from": "out/mcp",
          "to": "mcp"
        },
        {
          "from": "out/adapters",
          "to": "adapters"
        },
        {
          "from": "out/licenses",
          "to": "licenses"
        },
        {
          "from": "CHANGELOG.md",
          "to": "CHANGELOG.md"
        },
        {
          "from": "out/agent",
          "to": "agent"
        }
      ]
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "optionalDependencies": {
    "opencode-darwin-arm64": "1.18.34",
    "opencode-darwin-x64-baseline": "1.18.34",
    "opencode-linux-arm64": "1.18.34",
    "opencode-linux-x64-baseline": "1.18.34",
    "opencode-windows-arm64": "1.18.34",
    "opencode-windows-x64-baseline": "1.18.34"
  }
}
